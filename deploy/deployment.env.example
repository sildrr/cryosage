# Generated local copies must be mode 600. Do not commit your filled-in copy.
# Use a shared HDD data root for production, not a small home directory.
CRYOAGENT_WEB_DATA_ROOT=${HOME}/cryosage-data
CRYOAGENT_WEB_LOG_ROOT=${HOME}/cryosage-logs
CRYOAGENT_WEB_INPUT_ROOTS=/data/empiar
CRYOAGENT_WEB_PROJECT=P1
CRYOAGENT_WEB_PORT=8777
CRYOAGENT_CRYOSPARC_HOST=localhost
CRYOAGENT_CRYOSPARC_PORT=61000
CRYOSPARC_EMAIL=CHANGE_ME
CRYOSPARC_PASSWORD=CHANGE_ME
# Exact provider model IDs: some gateways require the openai/ prefix, others do not.
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-6.1-sol
CRYOAGENT_FIXED_API_MODEL=gpt-6-luna
# CPU-only controller partition; native CryoSPARC GPU jobs use registered lanes.
CRYOAGENT_WEB_SLURM_PARTITION=cpu
CRYOAGENT_WEB_GPU_LANES=gpu_slurm
CRYOAGENT_WEB_DYNAMIC_GPUS=1
CRYOAGENT_WEB_MAX_GPUS=8
# Optional controller-only --qos and node pin:
# CRYOAGENT_WEB_SLURM_QOS=gpu6
# CRYOAGENT_WEB_SLURM_NODELIST=cpu2
# No local proxy is assumed. If compute nodes need the login-node relay, configure:
# HTTPS_PROXY=http://127.0.0.1:18888
# HTTP_PROXY=http://127.0.0.1:18888
# CRYOAGENT_WEB_PROXY_HOST=LOGIN_NODE_COMPUTE_REACHABLE_HOST
# CRYOAGENT_WEB_PROXY_PORT=18889
# CRYOAGENT_WEB_PROXY_UPSTREAM=http://127.0.0.1:18888
# CRYOAGENT_WEB_PROXY_ALLOWED_HOSTS=api.example.com
# Standalone external tool environments and assets (not bundled):
# CRYOAGENT_CRYOSIFT_PYTHON=/envs/cryosift/bin/python
# CRYOAGENT_CRYOSIFT_RUNNER=/tools/CryoSift/cryosift_runner.py
# CRYOAGENT_CRYOSIFT_WEIGHTS=/tools/CryoSift/final_model_cont.pth
# CRYOAGENT_CRYOLO_PYTHON=/envs/cryolo/bin/python
# CRYOAGENT_CRYOLO_SOURCE=/tools/cryolo-1.9.9
# CRYOAGENT_CRYOLO_WEIGHTS=/tools/cryolo/gmodel_phosnet.h5
# CRYOAGENT_PROSHADE_BINARY=/tools/proshade/bin/proshade
# CRYOAGENT_KB_ROOT=/tools/kb_build_v2
# Or use the supported SQLite snapshot/document-retrieval interface:
# CRYOAGENT_BENCHMARK_KB_SNAPSHOT=/data/kb.sqlite
